<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Explicitly block both paths, including device transfer on OEM devices that handle
         allowBackup differently. Keystore-bound vault files cannot migrate with native backup. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
